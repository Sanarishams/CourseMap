<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/gradient_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:layout_marginBottom="40dp"
        android:paddingTop="100dp">

        <!-- App Title -->
        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CourseMap"
            android:textSize="46sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="40dp"
            android:gravity="center"
            android:textColor="@color/colorPrimaryVariant" />

        <!-- Illustration -->
        <ImageView
            android:id="@+id/appIllustration"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:src="@drawable/study_illustration"
            android:layout_marginBottom="30dp"
            android:contentDescription="App illustration" />

        <!-- USN Input -->
        <EditText
            android:id="@+id/usnInput"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:hint="Enter your USN"
            android:inputType="text"
            android:padding="16dp"
            android:textColor="@color/darkText"
            android:textColorHint="@color/colorPrimaryVariant"
            android:background="@drawable/edit_text_bg"
            android:elevation="4dp"
            android:textSize="16sp" />

        <!-- Login Button -->
        <Button
            android:id="@+id/loginBtn"
            android:layout_width="300dp"
            android:layout_height="60dp"
            android:text="LOGIN"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:layout_marginTop="28dp"
            android:background="@drawable/button_ripple"
            android:elevation="6dp" />

        <!-- Bottom spacer for better vertical balance -->
        <View
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:visibility="invisible" />

    </LinearLayout>

</ScrollView>
